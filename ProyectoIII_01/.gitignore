# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# FMOD - Don't ignore these specific files
!fmod.dll
!fmod_haptics.dll
!fmodL.dll
!fmodstudio.dll
!fmodstudioL.dll
!resonanceaudio.dll
!UnrealEditor-FMODStudio.dll
!UnrealEditor-FMODStudioEditor.dll
!UnrealEditor-FMODStudioNiagara.dll

# FMOD - Don't ignore these specific files
!fmod_vc.lib
!fmodL_vc.lib
!fmodstudio_vc.lib
!fmodstudioL_vc.lib

# FMOD - Don't ignore these specific files in Binaries/Plugins
!Plugins/FMODStudio/Binaries/
!Plugins/FMODStudio/Binaries/Win64/
!Plugins/FMODStudio/Binaries/Win64/fmod.dll
!Plugins/FMODStudio/Binaries/Win64/fmod_haptics.dll
